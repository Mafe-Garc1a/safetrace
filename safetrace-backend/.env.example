# Copiar como .env y completar. Nunca subir .env a git.
ENTORNO=local

# MongoDB: Atlas (recomendado, ya trae transacciones) o MongoDB Community instalado en el equipo.
#   Atlas:  mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
#   Local:  mongodb://localhost:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB=safetrace

# Secreto para JWT (generar uno seguro, p. ej.: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=
JWT_ALGORITHM=HS256
# Duración máxima del token; además la sesión se cierra tras MINUTOS_SESION sin actividad (RNF-11)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
MINUTOS_SESION=30

# n8n llama a /interno/* con el encabezado X-Credencial-Servicio
CREDENCIAL_SERVICIO_N8N=

# Primer administrador general: lo crea `python -m db.semillas`
ADMIN_CORREO=
ADMIN_CONTRASENA=

# Servicios externos (vacíos en local: el correo se simula y la subida de archivos responde 501)
PROVEEDOR_ARCHIVOS_URL=
CORREO_API_KEY=
